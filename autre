
    else {
       
        $stmt = $pdo->prepare("SELECT id FROM membres WHERE email = ?");
        $stmt->execute([$email]);
        
        if ($stmt->fetch()) {
            $message = "Cet email est déjà utilisé par un autre membre.";
            $typeMessage = 'error';
        } else {
            // Tout est correct : hachage sécurisé du mot de passe
            $hashedPassword = password_hash($password, PASSWORD_DEFAULT);

            // Insertion du membre en base de données
            $insertStmt = $pdo->prepare("INSERT INTO membres (prenom, nom, email, password) VALUES (?, ?, ?, ?)");
            if ($insertStmt->execute([$prenom, $nom, $email, $hashedPassword])) {
                $message = "Inscription réussie ! Vous pouvez maintenant vous connecter.";
                $typeMessage = 'success';
                // Optionnel : vider les champs après succès
                $_POST = [];
            } else {
                $message = "Une erreur est survenue lors de l'enregistrement.";
                $typeMessage = 'error';
            }
        }
    }
}

